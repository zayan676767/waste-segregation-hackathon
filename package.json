{
  "name": "waste-segregation-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Waste Segregation Assistant - client-side image classification with live dashboard",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:https": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm:dev:backend\" \"npm:dev:frontend:https\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:frontend:https": "npm --prefix frontend run dev:https",
    "ip": "node scripts/show-urls.mjs",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
